# ---------- API ----------
PORT=3000
ADMIN_PORT=8080

# ---------- PostgreSQL ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=syrve_loyalty
# Для локального запуска без Docker. В Docker перекрывается в docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/syrve_loyalty?schema=public

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------- Syrve ----------
# mock — работа без доступа к Syrve; real — живой API (нужны три значения ниже)
SYRVE_MODE=mock
SYRVE_API_URL=https://api-eu.syrve.live
SYRVE_API_LOGIN=
SYRVE_ORGANIZATION_ID=
# Задавать явно: в организации может быть несколько программ лояльности
SYRVE_PROGRAM_ID=

# ---------- Telegram ----------
# Токен от @BotFather. Пусто — бот не стартует, остальное работает.
TELEGRAM_BOT_TOKEN=
