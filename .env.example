# Скопіюйте у .env і заповніть порожні значення. Секрети — лише в .env (він у .gitignore).
# Значення за замовчуванням нижче робочі для docker compose up; порожні — секрети або дані вашої організації.

# ---------- API ----------
# NODE_ENV тут не задаємо: у Docker образ ставить production, без Docker за замовчуванням development.
# Порт, який слухає api. У Docker не змінюйте: 3000 жорстко прописаний у docker-compose.yml
# (публікація порту) і admin/nginx.conf (proxy_pass http://api:3000). Змінювати — лише для запуску без Docker.
PORT=3000
# Порт адмін-панелі на хості (http://localhost:8080)
ADMIN_PORT=8080

# ---------- PostgreSQL ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=syrve_loyalty
# Для запуску без Docker. У Docker перекривається в docker-compose.yml (хост postgres).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/syrve_loyalty?schema=public

# ---------- Redis (черги BullMQ) ----------
# Для запуску без Docker. У Docker REDIS_HOST перекривається на redis.
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------- Syrve ----------
# mock — без доступу до Syrve (дані в памʼяті кожного процесу, див. README);
# real — живий API, потрібні чотири значення нижче.
SYRVE_MODE=mock
SYRVE_API_URL=https://api-eu.syrve.live
# Ключ API (кабінет Syrve → API-логіни). Секрет.
SYRVE_API_LOGIN=
# Організація: POST /api/1/organizations → organizations[].id
SYRVE_ORGANIZATION_ID=
# Програма лояльності — задається явно, бо в організації їх кілька:
# POST /api/1/loyalty/syrve/program → Programs[].id
SYRVE_PROGRAM_ID=
# Гаманець цієї програми (≠ programId): баланс, нарахування й сповіщення — лише по ньому.
# Там само → Programs[].walletId
SYRVE_WALLET_ID=

# ---------- Telegram ----------
# Токен бота від @BotFather (/newbot). Секрет. Порожньо — бот і сповіщення вимкнені, решта працює.
TELEGRAM_BOT_TOKEN=

# ---------- Адмін-панель (обовʼязково, без них api не стартує) ----------
# Адмін створюється / оновлюється з цих значень при старті api. Входить лише поточний ADMIN_LOGIN.
ADMIN_LOGIN=admin
# Пароль адміна, мінімум 8 символів. Секрет.
ADMIN_PASSWORD=
# Підпис JWT сесії, мінімум 32 символи: openssl rand -hex 32. Секрет. Зміна скидає всі сесії.
JWT_SECRET=
# Прапорець Secure у cookie сесії. Порожньо — увімкнено в production (у Docker).
# false — лише для локального http://localhost:8080: Safari і вхід за IP без HTTPS не зберігають Secure-cookie.
COOKIE_SECURE=false
