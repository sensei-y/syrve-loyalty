// Модели добавляются по этапам (см. PLAN.md → «Данные»).
// О2: Guest. О4: Admin. О5: Operation. О6: NotifiedTransaction.
// Баланс и транзакции здесь не храним — источник правды Syrve.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Гости, зарегистрированные через бота. В Syrve нет списка «все гости организации»,
// а чужих гостей там много — список для панели берём отсюда.
model Guest {
  id              String   @id @default(uuid())
  telegramId      BigInt   @unique
  syrveCustomerId String   @unique
  phone           String   @unique // +380XXXXXXXXX
  name            String
  cardNumber      String
  lastRevision    BigInt   @default(0) // состояние поллера уведомлений (О6)
  createdAt       DateTime @default(now())
}
