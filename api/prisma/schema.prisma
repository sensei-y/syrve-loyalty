// Модели добавляются по этапам (см. PLAN.md → «Данные»).
// О2: Guest. О4: Admin. О5: Operation. О6: Notification (outbox).
// Баланс и транзакции здесь не храним — источник правды Syrve.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Гости, зарегистрированные через бота. В Syrve нет списка «все гости организации»,
// а чужих гостей там много — список для панели берём отсюда.
model Guest {
  id              String   @id @default(uuid())
  telegramId      BigInt   @unique
  syrveCustomerId String   @unique
  phone           String   @unique // +380XXXXXXXXX
  name            String
  cardNumber      String
  lastRevision    BigInt? // поллер О6: последняя обработанная ревизия; null — базовая точка ещё не взята
  createdAt       DateTime @default(now())
}

model Admin {
  id           String      @id @default(uuid())
  login        String      @unique
  passwordHash String // scrypt$<salt hex>$<hash hex>
  operations   Operation[]
}

enum OpType {
  TOPUP
  CHARGEOFF
}

enum OpStatus {
  PENDING // создана до вызова Syrve
  SUCCESS
  FAILED // Syrve ответил ошибкой или проверка баланса не прошла — бонусы не изменились
  UNKNOWN // таймаут / сеть: операция могла примениться, сверить в кабинете Syrve
}

// Журнал ручных операций панели: кто, когда, сколько, почему. Пишется до вызова Syrve (PENDING),
// уникальный idempotencyKey защищает от двойного клика и повторов запроса.
model Operation {
  id              String    @id @default(uuid())
  idempotencyKey  String    @unique
  syrveCustomerId String // гость Syrve; может быть не привязан к боту
  type            OpType
  amount          Decimal   @db.Decimal(12, 2)
  reason          String
  status          OpStatus  @default(PENDING)
  error           String?
  adminId         String
  admin           Admin     @relation(fields: [adminId], references: [id])
  createdAt       DateTime  @default(now())
  finishedAt      DateTime?

  @@index([syrveCustomerId, createdAt])
}

enum NotificationStatus {
  PENDING // найдено поллером, ждёт отправки
  SENDING // отправка началась: сообщение могло уйти — повторно не шлём
  SENT
  FAILED // гость заблокировал бота (403) или удалён — повторять бессмысленно
  UNKNOWN // процесс прервался во время отправки: дошло ли — неизвестно, не повторяем
}

// Outbox уведомлений О6 — источник правды, Redis (BullMQ) — только «будильник» с ретраями.
// Строки пишутся в одной транзакции со сдвигом Guest.lastRevision: очистка Redis уведомления не теряет.
// Одна транзакция Syrve = одна строка (PK) = максимум одно сообщение.
model Notification {
  syrveTransactionId String             @id
  guestId            String // Telegram берём из Guest при отправке: гость мог перепривязать бота
  sum                Decimal            @db.Decimal(12, 2)
  balanceAfter       Decimal?           @db.Decimal(12, 2)
  status             NotificationStatus @default(PENDING)
  attempts           Int                @default(0)
  lastError          String?
  createdAt          DateTime           @default(now())
  claimedAt          DateTime? // начало отправки (SENDING): при старте worker старые SENDING → UNKNOWN
  sentAt             DateTime?

  @@index([status])
}
