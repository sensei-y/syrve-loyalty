// Модели добавляются по этапам (см. PLAN.md → «Данные»).
// Этап 2: Guest. Этап 4: Admin. Этап 5: Operation.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
